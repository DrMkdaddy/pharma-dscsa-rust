[package]
name = "pharma-dscsa-client"
version = "1.0.0"
edition = "2021"
description = "Official high-speed Rust client for FDA DSCSA & EU FMD Drug Serialization API (21 USC 360eee) via RapidAPI Hub"
readme = "README.md"
authors = ["RapidAPI Microservices Portfolio"]
license = "MIT"
repository = "https://github.com/DrMkdaddy/pharma-dscsa-rust"
homepage = "https://rapidapi.com/noor-mkdad-apis-noor-mkdad-apis-default/api/us-fda-dscsa-eu-fmd-prescription-drug-serialization"
documentation = "https://rapidapi.com/noor-mkdad-apis-noor-mkdad-apis-default/api/us-fda-dscsa-eu-fmd-prescription-drug-serialization"
keywords = ["dscsa","pharma","gs1","ndc","healthcare"]
categories = ["parser-implementations","science","web-programming::http-client"]

[dependencies]
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls-native-roots", "blocking"] }
